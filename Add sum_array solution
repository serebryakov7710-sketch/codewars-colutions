def sum_array(arr):
    if arr is None or len(arr) <= 2:
        return 0
    
    total = 0
    smallest = arr[0]
    biggest = arr[0]
    
    for x in arr:
        total = total + x
        if x < smallest:
            smallest = x
        if x > biggest:
            biggest = x
            
    return total - smallest - biggest

