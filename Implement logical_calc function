def logical_calc(array, op):
    # Берем самый первый элемент в качестве стартового результата
    result = array[0]
    
    # Идем циклом по всем остальным элементам, начиная со второго (индекс 1)
    for i in range(1, len(array)):
        if op == "AND":
            result = result and array[i]
        elif op == "OR":
            result = result or array[i]
        elif op == "XOR":
            result = result != array[i]  # В Python неравенство работает как XOR для True/False
            
    return result
