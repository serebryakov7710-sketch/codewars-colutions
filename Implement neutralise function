def neutralise(s1, s2):
    result = ""
    # Цикл перебирает индексы (позиции) символов от нуля до длины строки
    for i in range(len(s1)):
        # Если символы в обеих строках одинаковые, берем любой из них
        if s1[i] == s2[i]:
            result += s1[i]
        # Если знаки разные, они нейтрализуются в ноль
        else:
            result += "0"
    return result
