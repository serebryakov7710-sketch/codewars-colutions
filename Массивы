def open_or_senior(data):
    # 1. Создаём пустой список, куда будем складывать наши ответы
    result = []
    
    # 2. Запускаем цикл, который по очереди проверит каждого человека
    for member in data:
        # Для удобства вытащим возраст и гандикап текущего человека
        age = member[0]        # первое число в паре
        handicap = member[1]   # второе число в паре
        
        # 3. Проверяем условия по нашей инструкции
        if age >= 55 and handicap > 7:
            result.append("Senior") # добавляем в список "Senior"
        else:
            result.append("Open")   # иначе добавляем "Open"
            
    # 4. Когда цикл закончился, возвращаем получившийся список ответов
    return result
